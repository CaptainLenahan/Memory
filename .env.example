# Copy to .env and fill in. Values set in the in-app Settings dialog take precedence.

# Anthropic API key for the in-app Claude panel (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Microsoft Planner sync — Azure app registration (public client flow enabled)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=organizations

# Optional: change the port
MEMORY_PORT=8765
