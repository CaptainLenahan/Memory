# Copy to .env and fill in. Values set in the in-app Settings dialog take precedence.

# Anthropic API key for the in-app Claude panel (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Microsoft Planner sync — Azure app registration (public client flow enabled)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=organizations

# Optional: change the port
MEMORY_PORT=8765

# Power Automate → Memory Planner sync: the bearer token the flow sends (Authorization: Bearer <token>).
# At least 32 random characters. Never commit the real value. For the installed app, put it in
# %LOCALAPPDATA%\Memory\.env (or set it as a user environment variable) and restart Memory.
MEMORY_PLANNER_SYNC_TOKEN=
